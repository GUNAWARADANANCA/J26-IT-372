# Copy values into backend/.env. Do not commit real passwords or the live MongoDB URI.

# First postmaster, created once when the API starts and no postmaster exists.
# Use at least 10 characters. Remove POSTMASTER_PASSWORD from the environment
# after the account exists if the machine is shared.
POSTMASTER_USERNAME=postmaster
POSTMASTER_PASSWORD=

# Send the session cookie only over HTTPS. Leave false for local HTTP.
# Production must use HTTPS and set this to true.
AUTH_COOKIE_SECURE=false

# Door attendance code. At least 16 characters. This is not put in the QR address.
ATTENDANCE_DOOR_SECRET=replace_with_a_unique_secret_at_least_16_characters
ATTENDANCE_TOKEN_SECONDS=120
ATTENDANCE_DUPLICATE_SECONDS=90
ATTENDANCE_RATE_LIMIT=8
# Optional public base URL or LAN IP override for QR code links:
PUBLIC_APP_URL=
ATTENDANCE_LAN_IP=
FRONTEND_PORT=5173

# Power BI app-owns-data embedding. Leave blank until a workspace and reports exist.
# Do not put these values in frontend code. Publish to web is not used.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_PRODUCTIVITY=
POWERBI_REPORT_FORECAST_MONITORING=
POWERBI_REPORT_KPI_SIMULATOR=
POWERBI_REPORT_KPI_FORECASTS=
POWERBI_REPORT_POSTAL_KPI_DASHBOARD=

# Where to copy each value. Leave every value blank in this example.
# POWERBI_TENANT_ID: Entra admin center, Overview, Tenant ID. The ctid on a share link is not a substitute.
# POWERBI_CLIENT_ID: Entra app registration, Application (client) ID.
# POWERBI_CLIENT_SECRET: that app's Certificates & secrets, a client secret value. Store it only here.
# POWERBI_WORKSPACE_ID: Power BI workspace, Workspace settings, the workspace GUID. Not My workspace.
# POWERBI_REPORT_POSTAL_KPI_DASHBOARD: the report GUID from the report URL (?reportId= or /reports/{id}). Not the /links/ sharing code.
# The service principal needs Member or Admin access on that workspace.
# The workspace must be on Power BI Embedded, Premium, or Fabric capacity. A share link is not enough.
