# Copy to backend/.env and adjust. Never commit the real .env.

# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=postassist_registered_mail
# When MongoDB on this computer is not running, the API starts it in the background
# (portable server in %USERPROFILE%\PostAssist by default). Set false to manage it yourself.
MONGODB_AUTOSTART=true
# MONGOD_PATH=C:\Users\you\PostAssist\mongodb\bin\mongod.exe
# MONGOD_DBPATH=C:\Users\you\PostAssist\mongo-data

# --- Security -----------------------------------------------------------------
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Front-end origins allowed to call the API (comma separated)
CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173
# Base of sender tracking links printed on receipts (the React app)
PUBLIC_BASE_URL=https://localhost:5173
TRACKING_PREFIX=PA-DEMO

# --- Demo data ----------------------------------------------------------------
DEMO_SEED=true
# Password of every seeded demo account (admin, counter2, hub2, postman2, pm2, ...)
DEMO_PASSWORD=PostAssist#2026
# The IoT scale. Put the SAME id and key in iot/postassist_scale_cam/config.h
SEED_DEVICE_ID=SCALECAM-01
SEED_DEVICE_KEY=change-me-device-key-32-characters
# Only for a board running a "pull" sketch (it answers /weight, /capture, /tare, /calibrate but does not
# push readings): its address on the Wi-Fi, used by tools/device_bridge.py. Leave empty for the push firmware.
BRIDGE_DEVICE_URL=
# true only after you have checked that the board still weighs correctly after a power cycle + tare
BRIDGE_CALIBRATION_SURVIVES_RESTART=false

# --- OCR / address processing ---------------------------------------------------
# Leave empty if tesseract.exe is on PATH or in C:\Program Files\Tesseract-OCR\
TESSERACT_CMD=
# none | ollama   (Gemma 3 4B IT through a local Ollama server, optional)
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# --- Weighing (prototype range and pairing rules) ------------------------------
WEIGHT_MIN_G=5
WEIGHT_MAX_G=500
READING_MAX_AGE_S=3
DEFAULT_WEIGHT_UNCERTAINTY_G=2.0
DEVICE_OFFLINE_AFTER_S=10

# --- Sender notifications -------------------------------------------------------
# file (writes .eml files to backend/storage/outbox_mail) | smtp | resend
NOTIFY_EMAIL_ADAPTER=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PostAssist LK <no-reply@example.test>
RESEND_API_KEY=
RESEND_FROM=
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=6
# Failure injection for experiments: none | fail_first | permanent | timeout_once | always_timeout
OUTBOX_FAULT_MODE=none

# --- Postal KPI desk (backend/db.py, used by main.py / routes.py) --------------------
# Its own database, so its collections stay apart from registered mail. Without KPI_MONGODB_URI
# it uses MONGODB_URI above (the same local server). For the team's Atlas cluster, e.g.
# KPI_MONGODB_URI=mongodb+srv://nethunigunawaradana_db_user:<db_password>@postassistlk.gc2o1zr.mongodb.net/?appName=PostAssistLK
KPI_MONGODB_URI=
KPI_MONGODB_DB=postassist

