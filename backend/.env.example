# Copy to backend/.env and adjust. Never commit the real .env.

# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=postassist_registered_mail
# When MongoDB on this computer is not running, the API starts it in the background
# (portable server in %USERPROFILE%\PostAssist by default). Set false to manage it yourself.
MONGODB_AUTOSTART=true
# MONGOD_PATH=C:\Users\you\PostAssist\mongodb\bin\mongod.exe
# MONGOD_DBPATH=C:\Users\you\PostAssist\mongo-data

# --- Security -----------------------------------------------------------------
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Front-end origins allowed to call the API (comma separated)
CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173
# Base of sender tracking links printed on receipts (the React app)
PUBLIC_BASE_URL=https://localhost:5173
TRACKING_PREFIX=PA-DEMO

# --- Demo data ----------------------------------------------------------------
DEMO_SEED=true
# Password of every seeded demo account (admin, counter2, hub2, postman2, pm2, ...)
DEMO_PASSWORD=change-me-demo-password
# The IoT scale. Put the SAME id and key in iot/postassist_scale_cam/config.h
SEED_DEVICE_ID=SCALECAM-01
SEED_DEVICE_KEY=change-me-device-key-32-characters
# Only for a board running a "pull" sketch (it answers /weight, /capture, /tare, /calibrate but does not
# push readings): its address on the Wi-Fi, used by tools/device_bridge.py. Leave empty for the push firmware.
BRIDGE_DEVICE_URL=
# true only after you have checked that the board still weighs correctly after a power cycle + tare
BRIDGE_CALIBRATION_SURVIVES_RESTART=false

# --- OCR / address processing ---------------------------------------------------
# Leave empty if tesseract.exe is on PATH or in C:\Program Files\Tesseract-OCR\
TESSERACT_CMD=
# none | ollama   (Gemma 3 4B IT through a local Ollama server, optional)
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# --- Weighing (prototype range and pairing rules) ------------------------------
WEIGHT_MIN_G=5
WEIGHT_MAX_G=500
READING_MAX_AGE_S=3
DEFAULT_WEIGHT_UNCERTAINTY_G=2.0
DEVICE_OFFLINE_AFTER_S=10

# --- Sender notifications -------------------------------------------------------
# file (writes .eml files to backend/storage/outbox_mail) | smtp | resend
NOTIFY_EMAIL_ADAPTER=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PostAssist LK <no-reply@example.test>
RESEND_API_KEY=
RESEND_FROM=
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=6
# Failure injection for experiments: none | fail_first | permanent | timeout_once | always_timeout
OUTBOX_FAULT_MODE=none

# --- Postal KPI desk ------------------------------------------------------------
# Its own database, so its collections stay apart from registered mail. Without KPI_MONGODB_URI
# it uses MONGODB_URI above (the same local server). For the team's Atlas cluster, e.g.
# KPI_MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>/<database>
KPI_MONGODB_URI=
KPI_MONGODB_DB=postassist

# Send the session cookie only over HTTPS. Leave false for local HTTP.
# Production must use HTTPS and set this to true.
AUTH_COOKIE_SECURE=false

# First postmaster, created once when the API starts and no postmaster exists.
# Use at least 10 characters. Remove POSTMASTER_PASSWORD from the environment
# after the account exists if the machine is shared.
POSTMASTER_USERNAME=postmaster
POSTMASTER_PASSWORD=

# --- Door Attendance & QR Code Settings ---------------------------------------
# Door attendance code. At least 16 characters. This is not put in the QR address.
ATTENDANCE_DOOR_SECRET=replace_with_a_unique_secret_at_least_16_characters
ATTENDANCE_TOKEN_SECONDS=120
ATTENDANCE_DUPLICATE_SECONDS=90
ATTENDANCE_RATE_LIMIT=8
# Optional public base URL or LAN IP override for QR code links:
PUBLIC_APP_URL=
ATTENDANCE_LAN_IP=
FRONTEND_PORT=5173

# --- Power BI app-owns-data embedding -----------------------------------------
# Leave blank until a workspace and reports exist.
# Do not put these values in frontend code. Publish to web is not used.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_PRODUCTIVITY=
POWERBI_REPORT_FORECAST_MONITORING=
POWERBI_REPORT_KPI_SIMULATOR=
POWERBI_REPORT_KPI_FORECASTS=
POWERBI_REPORT_POSTAL_KPI_DASHBOARD=

# Where to copy each value. Leave every value blank in this example.
# POWERBI_TENANT_ID: Entra admin center, Overview, Tenant ID. The ctid on a share link is not a substitute.
# POWERBI_CLIENT_ID: Entra app registration, Application (client) ID.
# POWERBI_CLIENT_SECRET: that app's Certificates & secrets, a client secret value. Store it only here.
# POWERBI_WORKSPACE_ID: Power BI workspace, Workspace settings, the workspace GUID. Not My workspace.
# POWERBI_REPORT_POSTAL_KPI_DASHBOARD: the report GUID from the report URL (?reportId= or /reports/{id}). Not the /links/ sharing code.
# The service principal needs Member or Admin access on that workspace.
# The workspace must be on Power BI Embedded, Premium, or Fabric capacity. A share link is not enough.
