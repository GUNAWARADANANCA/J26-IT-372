# Secure embed URL from Power BI: File → Embed report → Website or portal.
# It looks like https://app.powerbi.com/reportEmbed?reportId=...&autoAuth=true&ctid=...
# Do not paste a sharing link (app.powerbi.com/links/...) or a Publish to web link (app.powerbi.com/view).
# Do not put client secrets, certificates, or access tokens in any VITE_ variable.
# Copy this file to frontend/.env.local and set the value there. Leave it empty until you have the URL.
VITE_POWERBI_EMBED_URL=

# Public base URL used when generating the Post Office QR Attendance link.
# - Local LAN testing (e.g. phone on same Wi-Fi): https://192.168.1.3:5173 (or leave blank to auto-detect LAN IPv4 from backend)
# - Production deployment: https://postassist.slpost.gov.lk
VITE_PUBLIC_APP_URL=
